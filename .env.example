# Site (NEXT_PUBLIC_SITE_URL utilisé pour le sitemap, Open Graph, canonical)
NEXT_PUBLIC_SITE_NAME=Vincent Tourneret
NEXT_PUBLIC_SITE_URL=https://vincent-tourneret.fr
# Optionnel : description (défaut = texte ciblé développeur freelance Besançon)
# NEXT_PUBLIC_SITE_DESCRIPTION=

# SEO – Vérification propriété (Google Search Console, Bing Webmaster)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxx
# NEXT_PUBLIC_BING_SITE_VERIFICATION=xxx

# Réseaux sociaux (hero + footer)
NEXT_PUBLIC_LINKEDIN_URL=https://fr.linkedin.com/in/vincent-tourneret-7891b2173
NEXT_PUBLIC_GITHUB_URL=https://github.com/VincentTourneret

# Formulaire de contact (Brevo)
BREVO_API_KEY=xkeysib-xxx
CONTACT_EMAIL=contact@example.com
# Expéditeur des emails (doit être vérifié dans Brevo) ; par défaut = CONTACT_EMAIL
# BREVO_SENDER_EMAIL=contact@example.com

# Mentions légales (optionnel ; par défaut : éditeur = SITE_NAME, hébergeur = OVH SAS)
# NEXT_PUBLIC_LEGAL_EDITOR_NAME=
# NEXT_PUBLIC_LEGAL_HOST_NAME=OVH SAS
# NEXT_PUBLIC_LEGAL_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France
